# ---------------------------------------------------------------------------
# Cruise — environment
#
# Copy to .env and fill in. Nothing here has a safe default in production:
# every value that is missing either stops the app at boot (deliberately) or
# turns a feature off and says so on screen.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# PostgreSQL. Use Neon's POOLED connection string — the host contains
# `-pooler` — because a serverless function that opens a direct connection per
# invocation exhausts the connection limit long before anything else.
#
# There is no local-file fallback. SQLite was removed on 2026-09-17: Vercel's
# filesystem is read-only and discarded between requests, so a file database
# there loses every write with no error at all.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/cruise?sslmode=verify-full"

# --- Sessions --------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The deployment's own URL. A wrong value here breaks sign-in with a redirect
# loop rather than an error, so it is worth checking after the first deploy.
NEXTAUTH_URL="http://localhost:3000"

# --- Encryption ------------------------------------------------------------
# Protects per-account Meta access tokens at rest. At least 32 characters.
# Generate with: openssl rand -base64 48
#
# Rotating this invalidates every stored per-account token — they have to be
# re-authorised, not recovered. Back it up with the same care as the database.
CREDENTIAL_KEY=""

# --- Meta ------------------------------------------------------------------
# The app, and the system user token that reaches the ad accounts assigned to
# it in Business Settings. One token covers every account in the same business.
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""

# Must be exactly "false" for Cruise to touch the real API. Any other value —
# including unset — keeps it in mock mode.
USE_MOCK_META="true"

# Optional. The pixel event counted as a lead, for accounts that do not set
# their own on the Ad accounts screen.
META_CONVERSION_EVENT=""

# Optional. Pin the Graph API version, so a version-specific regression can be
# backed out without a code change.
META_GRAPH_VERSION="v23.0"

# Optional. Rupees per day a single campaign may be given before publishing
# refuses. Defaults to 5000.
META_MAX_DAILY_BUDGET="5000"

# --- Auto-pause ------------------------------------------------------------
# The shared secret a scheduler presents to POST /api/lead-targets/enforce.
# Vercel Cron sends it as the `x-autopause-secret` header. Without this set,
# only a signed-in editor can run enforcement — which means on a server it does
# not run on a schedule at all.
# Generate with: openssl rand -hex 32
AUTO_PAUSE_SECRET=""

# --- Connections -----------------------------------------------------------
# Optional. Set to "true" ONLY for a Postgres with a self-signed certificate.
# It encrypts the connection without checking who is on the other end, so it
# protects against eavesdropping and not against impersonation. Neon presents a
# publicly trusted certificate and does not need this.
DATABASE_SSL_NO_VERIFY="false"

# Optional. Postgres connections per serverless instance. Keep it small: a
# large pool multiplied by many warm instances exhausts the database's limit
# while barely doing any work.
DATABASE_POOL_MAX="5"
